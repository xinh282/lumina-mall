<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lumina.mapper.OrderMapper">
    <resultMap id="OrderVOMap" type="com.lumina.vo.OrderVO">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="receiverAddress" column="receiver_address"/>
        <result property="payTime" column="pay_time"/>
        <result property="createTime" column="create_time"/>
        <collection property="orderItems" ofType="com.lumina.vo.OrderItemVO">
            <id property="id" column="oi_id"/>
            <result property="orderId" column="oi_order_id"/>
            <result property="productId" column="oi_product_id"/>
            <result property="productName" column="oi_product_name"/>
            <result property="productPrice" column="oi_product_price"/>
            <result property="quantity" column="oi_quantity"/>
            <result property="totalPrice" column="oi_total_price"/>
        </collection>
    </resultMap>

    <select id="selectOrderDetail" resultMap="OrderVOMap">
        SELECT o.*,
               oi.id AS oi_id, oi.order_id AS oi_order_id, oi.product_id AS oi_product_id,
               oi.product_name AS oi_product_name, oi.product_price AS oi_product_price,
               oi.quantity AS oi_quantity, oi.total_price AS oi_total_price
        FROM l_order o
        LEFT JOIN l_order_item oi ON o.id = oi.order_id
        WHERE o.id = #{orderId}
    </select>
</mapper>
